{
  "version": 1,
  "description": "Path lists shared by the flow guard hook and the claude-desk app guard. Semantics: docs/protected-paths.md. The matching logic stays in each guard; only these lists are shared.",
  "secrets": {
    "envSafeSuffixes": ["example", "sample", "template", "dist", "default", "defaults"],
    "keyExtensions": ["pem", "key", "p12", "pfx", "jks", "keystore"],
    "sshKeyNames": ["id_rsa", "id_dsa", "id_ecdsa", "id_ed25519"],
    "awsCredentialsPath": ".aws/credentials",
    "names": ["credentials", "secret", "secrets"],
    "dirs": ["secret", "secrets"],
    "productionConfigEnvs": ["prod", "production"]
  },
  "noise": {
    "anywhere": ["node_modules", ".git", ".venv", "venv", "__pycache__", ".angular", ".next", ".gradle", ".idea"],
    "projectLevel": ["target", "dist", "build", "out", "coverage"],
    "projectMarkers": ["package.json", "pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts", "Cargo.toml", "pyproject.toml", "setup.py", "go.mod", "CMakeLists.txt", "angular.json"],
    "fileSuffixes": [".min.js", ".min.css", ".map"]
  },
  "noWrite": {
    "lockfiles": ["package-lock.json", "npm-shrinkwrap.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock", "uv.lock", "pipfile.lock", "composer.lock", "cargo.lock", "gradle.lockfile"],
    "generatedDirs": ["generated", "generated-sources", "__generated__"],
    "generatedInfix": ".generated."
  }
}
